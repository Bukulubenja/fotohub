# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DATABASE_URL=sqlite:///db.sqlite3
# Production example:
# DATABASE_URL=postgres://fotohub:password@db-host:5432/fotohub
# DJANGO_ALLOWED_HOSTS=fotohub.ug,www.fotohub.ug
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fotohub.ug
# DJANGO_NUM_PROXIES=1            # number of reverse proxies in front of the app
# DJANGO_ADMIN_URL=some-unguessable-path/
# CACHE_URL=dbcache://fotohub_cache   # run `manage.py createcachetable` once

# Object storage (Cloudflare R2 in production; any S3-compatible bucket works).
# STORAGE_BUCKET=fotohub-prod
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# DEFAULT_STORAGE_QUOTA_BYTES=5368709120   # 5 GiB until billing sets per-plan quotas

# Celery. Dev runs tasks inline (CELERY_TASK_ALWAYS_EAGER defaults to True in dev).
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
