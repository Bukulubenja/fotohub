# Copy to .env for local development. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DATABASE_URL=sqlite:///db.sqlite3
# Production example:
# DATABASE_URL=postgres://fotohub:password@db-host:5432/fotohub
# DJANGO_ALLOWED_HOSTS=fotohub.ug,www.fotohub.ug
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fotohub.ug
# DJANGO_NUM_PROXIES=1            # number of reverse proxies in front of the app
# DJANGO_ADMIN_URL=some-unguessable-path/
# CACHE_URL=dbcache://fotohub_cache   # run `manage.py createcachetable` once

# Object storage (Cloudflare R2 in production; any S3-compatible bucket works).
# STORAGE_BUCKET=fotohub-prod
# STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# DEFAULT_STORAGE_QUOTA_BYTES=5368709120   # 5 GiB until billing sets per-plan quotas
# Check the bucket (and set CORS + lifecycle) with:
#   manage.py storage_check --origin http://localhost:5173 --apply

# Celery. Dev runs tasks inline (CELERY_TASK_ALWAYS_EAGER defaults to True in dev).
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False

# Payments. "fake" moves no money (dev/tests); prod refuses to start with it.
# BILLING_PROVIDER=fake
# BILLING_FAKE_WEBHOOK_SECRET=...   # only for testing the webhook by hand

# Photo sales: fixed price per photo. Update the shilling price when the rate moves.
# SHOP_PRICE_USD_CENTS=24
# SHOP_PRICE_UGX=900
# SITE_URL=https://fotohub.ug        # used for links in receipt emails
# MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
