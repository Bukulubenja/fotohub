# Copy to deploy/.env on the server (never commit it). Lines after "CHANGE:" are required.
# Comments stay on their own lines: some env-file parsers keep "# ..." as part of a value.

# --- Site ---
# CHANGE: the domain, or <server-ip>.sslip.io until FotoHub has one (e.g. 102.130.1.2.sslip.io)
SITE_ADDRESS=fotohub.example.com
# CHANGE: the same address with https://
SITE_URL=https://fotohub.example.com
BILLING_RETURN_URL=https://fotohub.example.com/
DJANGO_CSRF_TRUSTED_ORIGINS=https://fotohub.example.com
# CHANGE: the address, plus localhost for the container health check
DJANGO_ALLOWED_HOSTS=fotohub.example.com,localhost
# CHANGE: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# CHANGE: an unguessable admin path ending in /, e.g. ops-7f3k2/
DJANGO_ADMIN_URL=
DJANGO_NUM_PROXIES=1
# Short while testing HTTPS; delete the line once everything works (default: one year).
SECURE_HSTS_SECONDS=300

# --- Database (shared by the db service and the app) ---
# CHANGE: a long random string
POSTGRES_PASSWORD=

# --- Object storage (Cloudflare R2) ---
STORAGE_BUCKET=fotohub-prod
STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Payments (Flutterwave): test key until KYC, then the live one ---
BILLING_PROVIDER=flutterwave
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# --- Email (receipts, reminders): any SMTP service ---
DEFAULT_FROM_EMAIL=FotoHub <photos@fotohub.example.com>
# Shown to guests for payment help and takedown requests (empty: they're sent to the photographer).
SUPPORT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Error tracking (optional until launch) ---
SENTRY_DSN=

# --- Photo prices ---
SHOP_PRICE_UGX=900
SHOP_PRICE_USD_CENTS=24
